# ---------------------------------------------------------------------------
# Backtest OUTPUT. data/ is 2.6 GB of blotters, equity curves and run logs --
# a single blotter_*.csv is up to 387 MB. All of it is regenerated by a run.
# ---------------------------------------------------------------------------
data/*
!data/.gitkeep

# The same files if a run ever writes beside the code instead of into data/.
blotter*.csv
equity_curve*.csv
trades*.csv
*.log

# ---------------------------------------------------------------------------
# Verbatim copies of QMT's (Thinktrader) own shipped scripts, kept locally as
# a reference for what the live GUI engine actually does. They are the
# vendor's code, not ours, so they are not redistributed here -- every QMT
# install has them under bin.x64\Lib\site-packages\ and in the examples folder.
# Remove this rule if you decide redistributing them is fine.
# ---------------------------------------------------------------------------
qmt_reference/

# ---------------------------------------------------------------------------
# Local machine state
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.bak
*.bak_*
*.old
*.orig
.venv/
venv/
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# Anything holding a token or a credential, in case one is ever added.
*.token
*secret*
*credential*
.env

# Input data stores are outside this folder (C:\AI_STOCK\dataset\...), but if a
# copy is ever dropped in here, keep it out.
*.parquet
*.duckdb
*.DAT
